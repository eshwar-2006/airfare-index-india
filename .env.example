# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FLIGHT_API_KEY & FLIGHT_API_SECRET: Optional credentials for live GDS/flight search API (e.g. Amadeus/Duffel).
FLIGHT_API_KEY="MY_FLIGHT_API_KEY"
FLIGHT_API_SECRET="MY_FLIGHT_API_SECRET"

# PLACES_API_KEY & MAPS_API_KEY: Optional Google Maps Platform keys for live places/map tiles.
PLACES_API_KEY="MY_PLACES_API_KEY"
MAPS_API_KEY="MY_MAPS_API_KEY"
